# Server-only environment variables. NEVER expose SUPABASE_SERVICE_ROLE_KEY in frontend code.
SUPABASE_URL="https://YOUR_PROJECT.supabase.co"
SUPABASE_SERVICE_ROLE_KEY="YOUR_SUPABASE_SERVICE_ROLE_KEY"

# Optional: Gemini key if the site's AI features are used.
GEMINI_API_KEY="YOUR_GEMINI_API_KEY"

# Optional: public URL of the deployed site.
APP_URL="https://YOUR-DOMAIN"
